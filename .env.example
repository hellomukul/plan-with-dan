# Plan with Dan reads .env from this folder first, then from the folder above it.
# Copy this file to .env (or use the .env one level up) and fill in ONE key.
# Never commit your real .env.

# Course key (used with gpt-6-luna through the Portkey gateway). Preferred.
PORTKEY_API_KEY=your-portkey-api-key-here

# Or your own OpenAI key (used if PORTKEY_API_KEY is empty).
OPENAI_API_KEY=your-openai-api-key-here

# ---- Optional ----
# MODEL_NAME=gpt-6-luna
# DATABASE_URL=postgresql://user:pass@host/db   # default: SQLite at data/app.db
# RUN_BUDGET_USD=0.05                           # max spend per chat turn
# DAILY_BUDGET_USD=0.50                         # max spend per student per day
